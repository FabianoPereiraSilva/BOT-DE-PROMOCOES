{
  "name": "bot-promocoes-shopee-ml",
  "version": "1.0.0",
  "description": "Bot autônomo 24/7 de caça e publicação de promoções da Shopee e Mercado Livre para Telegram",
  "main": "dist/server/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
