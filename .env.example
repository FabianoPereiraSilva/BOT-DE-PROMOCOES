# ==========================================
# CONFIGURAÇÕES DO SERVIDOR WEB E PAINEL
# ==========================================
PORT=3000
HOST=0.0.0.0

# ==========================================
# TELEGRAM BOT (Canais e Grupos)
# ==========================================
# Crie seu bot no Telegram falando com o @BotFather para pegar o Token
TELEGRAM_BOT_TOKEN=
# ID do Canal ou Grupo (Exemplo: @meucanalpromocoes ou -1001234567890)
TELEGRAM_CHAT_ID=

# ==========================================
# AFILIADOS MERCADO LIVRE
# ==========================================
# Seu código/tag de afiliado do Mercado Livre (se houver)
MERCADOLIVRE_AFFILIATE_TAG=

# ==========================================
# AFILIADOS SHOPEE
# ==========================================
# ID do Afiliado ou Link Padrão / Shopee Open API (Opcional)
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_UNIVERSAL_LINK_PREFIX=https://s.shopee.com.br/

# ==========================================
# PILOTO AUTOMÁTICO (AUTOPILOT 24/7)
# ==========================================
# Ativar ou desativar o piloto automático (true / false)
AUTOPILOT_ENABLED=true
# Intervalo de caça em minutos (ex: 20 minutos)
AUTOPILOT_INTERVAL_MINUTES=20
# Desconto mínimo para postar automaticamente (ex: 30%)
MIN_DISCOUNT_PERCENT=25
# Preço mínimo do produto em R$ (evita quinquilharias de R$ 1)
MIN_PRICE=15.00
# Intervalo mínimo de repetição do mesmo produto em horas (evita duplicação)
DEDUPLICATION_HOURS=48

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI IA)
# ==========================================
# Chave de API do Google Gemini (pegue gratuitamente em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_AI_ENABLED=true

